/* --- HEADER & NAVBAR ARCHITECTURE --- */
 header {
  background: var(--header-bg);
  box-shadow: var(--header-shadow);
  position: sticky;
  top: 0;
  z-index: 1000;
}

/* =========================================================
     RESET KHUSUS HALAMAN TATA LETAK BLOGGER (ANTI MELAYANG)
     ========================================================= */
  body#layout header {
    position: static !important;
    height: auto !important;
  }
  
  body#layout .nav-wrapper {
    display: block !important; /* Mematikan flexbox agar tidak tumpang tindih */
    height: auto !important;   /* Menghapus batas tinggi 70px agar kotak widget bisa membesar */
    overflow: hidden !important;
    padding-bottom: 30px !important;
  }

  body#layout .brand-logo,
  body#layout .nav-menu {
    display: block !important;
    float: left !important;
    width: 48% !important; /* Membuat kotak sejajar rapi kiri dan kanan */
    margin: 0 1% 20px 1% !important;
    height: auto !important;
  }
  
  body#layout .nav-menu ul,
  body#layout .nav-menu ul li {
    display: block !important;
    height: auto !important;
  }

  .nav-wrapper {
    display: flex;
    align-items: center;
    height: 70px;
    position: relative;
  }

  .brand-logo h1 {
    font-size: 22px;
    font-weight: 800;
  }

  .brand-logo h1 a {
    color: #FFFFFF !important; /* Logo putih bersih di mode terang */
  }

/* --- NAVBAR UTAMA & DESKTOP --- */
  .nav-menu {
    margin-left: auto;
    margin-right: 20px;
  }

  .nav-menu ul {
    display: flex;
    align-items: center;
    gap: 25px;
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-menu ul li {
    position: relative;
    list-style: none;
    height: 70px;
    display: flex;
    align-items: center;
  }

  .nav-menu ul li a {
    font-size: 15px;
    font-weight: 600;
    color: var(--nav-text);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    position: relative;
    padding: 6px 4px;
  }

  /* Styling Ikon Menu di Samping Kiri */
  .nav-menu ul li a .menu-icon {
    font-size: 14px;
    width: 18px;
    text-align: center;
    flex-shrink: 0;
  }

  /* Animasi Garis Bawah Melayang (Underline Slide) & Penanda untuk Desktop */
  .nav-menu ul li a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: #FFFFFF;
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 2px;
  }

  .nav-menu ul li a:hover::after,
  .nav-menu ul li.dropdown-parent:hover > a::after {
    width: 100%;
  }

  .nav-menu ul li a:hover {
    color: #FFFFFF !important;
    transform: translateY(-1px);
  }

  .nav-menu ul li a:active {
    transform: scale(0.95);
  }

  .nav-menu .widget, 
  .brand-logo .widget {
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    height: 100%;
  }

  /* --- DESKTOP DROPDOWN SOLID --- */
  .nav-menu ul li.dropdown-parent > a .dropdown-arrow {
    font-size: 9px;
    transition: transform 0.3s ease;
    margin-left: 6px;
  }

  .nav-menu ul li.dropdown-parent ul.dropdown-menu {
    position: absolute;
    top: calc(100% - 5px);
    left: 0;
    min-width: 200px;
    background-color: #FFFFFF !important;
    opacity: 1 !important;
    border: 1px solid #E2E8F0;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    border-radius: 12px;
    padding: 8px 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 99999 !important;
    list-style: none;
  }

  [data-theme="dark"] .nav-menu ul li.dropdown-parent ul.dropdown-menu {
    background-color: #1E293B !important;
    border-color: #334155 !important;
  }

  .nav-menu ul li.dropdown-parent:hover ul.dropdown-menu {
    visibility: visible;
    opacity: 1 !important;
    transform: translateY(0);
  }

  .nav-menu ul li.dropdown-parent:hover > a .dropdown-arrow {
    transform: rotate(180deg);
  }

  .nav-menu ul li.dropdown-parent ul.dropdown-menu li.sub-menu-item {
    width: 100%;
    height: auto;
    display: block;
  }

  .nav-menu ul li.dropdown-parent ul.dropdown-menu li.sub-menu-item a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-main);
    border: none !important;
    transition: all 0.2s ease;
    width: 100%;
  }

  .nav-menu ul li.dropdown-parent ul.dropdown-menu li.sub-menu-item a::after {
    display: none !important;
  }

  .nav-menu ul li.dropdown-parent ul.dropdown-menu li.sub-menu-item a:hover {
    background-color: var(--section-light-bg);
    color: var(--hero-bg) !important; 
    padding-left: 22px;
  }

  /* --- TOMBOL AKSI KANAN --- */
  .nav-actions-right {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: auto;
  }

  .theme-toggle-btn, 
  .mobile-menu-toggle {
    background: none;
    border: none;
    font-size: 18px;
    cursor: pointer;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.15);
    color: #FFFFFF !important;
    transition: all 0.3s ease;
  }

  .theme-toggle-btn:hover, 
  .mobile-menu-toggle:hover {
    background-color: rgba(255, 255, 255, 0.25);
  }

  .mobile-menu-toggle {
    display: none;
  }

  /* --- RESPONSIVE MOBILE (PADAT, RINGKAS, DENGAN PENANDA & TANPA GARIS) --- */
  @media (max-width: 900px) {
    .nav-menu ul,
    .nav-menu ul li,
    .nav-menu ul li a {
      border: none !important;
      border-bottom: none !important;
      background-image: none !important;
    }

    .nav-menu ul li {
      height: auto;
      flex-direction: column;
      align-items: flex-start;
      border: none !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .mobile-menu-toggle {
      display: flex !important;
    }

    .nav-menu {
      display: none;
      position: absolute;
      top: 70px;
      left: 0;
      width: 100%;
      background: var(--header-bg);
      box-shadow: 0 15px 25px rgba(0,0,0,0.1);
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      padding: 8px 12px;
      margin: 0;
      z-index: 999;
    }

    .nav-menu.active {
      display: block !important;
    }

    .nav-menu ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
      width: 100%;
      border: none !important;
    }

    /* Tombol Menu Utama Mobile (Padat & Efek Penanda Samping Kiri) */
    .nav-menu > ul > li > a {
      display: flex !important;
      align-items: center !important;
      justify-content: flex-start !important;
      gap: 10px !important;
      padding: 8px 12px !important;
      font-size: 14px !important;
      font-weight: 600 !important;
      color: var(--nav-text) !important;
      border: none !important;
      border-bottom: none !important;
      box-shadow: none !important;
      width: 100% !important;
      border-radius: 8px;
      transition: all 0.2s ease-in-out !important;
      margin-bottom: 2px;
      position: relative;
      overflow: hidden;
    }

    .nav-menu ul li a::after {
      display: none !important;
    }

    /* Garis penanda vertikal di sisi kiri menu saat disentuh / aktif */
    .nav-menu > ul > li > a::before {
      content: '';
      position: absolute;
      left: 0;
      top: 50%;
      transform: translateY(-50%) scaleY(0);
      width: 4px;
      height: 65%;
      background-color: #FFFFFF;
      border-radius: 0 4px 4px 0;
      transition: transform 0.2s ease-in-out;
    }

    /* Efek Sentuh / Klik (Hover & Active) pada Menu Mobile */
    .nav-menu > ul > li > a:hover,
    .nav-menu > ul > li > a:active {
      background-color: rgba(255, 255, 255, 0.22) !important;
      color: #FFFFFF !important;
      padding-left: 16px !important;
      transform: scale(0.98);
    }

    .nav-menu > ul > li > a:hover::before,
    .nav-menu > ul > li > a:active::before {
      transform: translateY(-50%) scaleY(1);
    }

    .nav-menu ul li.dropdown-parent > a {
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      width: 100% !important;
      border: none !important;
    }

    .nav-menu ul li.dropdown-parent > a .dropdown-arrow {
      width: 24px;
      height: 24px;
      background-color: rgba(255, 255, 255, 0.1);
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      color: #FFFFFF;
      transition: transform 0.3s ease;
      flex-shrink: 0;
      margin-left: auto !important;
    }

    .nav-menu ul li.dropdown-parent.open > a .dropdown-arrow {
      transform: rotate(180deg);
      background-color: #FFFFFF;
      color: var(--hero-bg);
    }

    .nav-menu ul li.dropdown-parent ul.dropdown-menu {
      position: static !important;
      width: 100%;
      box-shadow: 0 5px 15px rgba(0,0,0,0.06);
      border: 1px solid #E2E8F0;
      background-color: #FFFFFF !important;
      border-radius: 8px;
      padding: 4px;
      margin-top: 2px;
      display: none;
    }

    [data-theme="dark"] .nav-menu ul li.dropdown-parent ul.dropdown-menu {
      background-color: #1E293B !important;
      border-color: #334155 !important;
    }

    .nav-menu ul li.dropdown-parent ul.dropdown-menu li.sub-menu-item a {
      padding: 6px 10px !important;
      font-size: 13px !important;
      color: var(--text-main) !important;
      border: none !important;
      border-bottom: none !important;
      background-color: transparent !important;
      display: flex !important;
      align-items: center !important;
      gap: 8px !important;
      border-radius: 6px;
    }

    .nav-menu ul li.dropdown-parent ul.dropdown-menu li.sub-menu-item a:active,
    .nav-menu ul li.dropdown-parent ul.dropdown-menu li.sub-menu-item a:hover {
      background-color: rgba(0, 102, 255, 0.1) !important;
      color: var(--primary-color) !important;
      padding-left: 14px !important;
      transform: scale(0.98);
    }

    .nav-menu ul li.dropdown-parent.open ul.dropdown-menu {
      display: flex !important;
    }
  }
